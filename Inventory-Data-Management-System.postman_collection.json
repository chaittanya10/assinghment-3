{
  "info": {
    "_postman_id": "0c3672c4-6aa7-4b4b-b0aa-17f925987f17",
    "name": "Inventory Data Management System",
    "description": "Requests for the assignment API. Set baseUrl to http://localhost:5000. Create Product saves productId automatically for later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "productId", "value": "" }
  ],
  "item": [
    {
      "name": "Products CRUD",
      "item": [
        {
          "name": "Create Product",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created product', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "if (body._id) pm.collectionVariables.set('productId', body._id);", "pm.test('Has stock value', () => pm.expect(body).to.have.property('stockValue'));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Gel Pen Pack of 15\",\n  \"sku\": \"STNY-PN-713\",\n  \"category\": \"Stationery\",\n  \"price\": 120,\n  \"quantity\": 40,\n  \"reorderLevel\": 20,\n  \"supplier\": \"Cello Pens\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/products" }
        },
        {
          "name": "Get All Products (filter, sort, paginate)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/products?page=1&limit=10&sortBy=name&order=asc", "host": ["{{baseUrl}}"], "path": ["api", "products"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }, { "key": "sortBy", "value": "name" }, { "key": "order", "value": "asc" }] } }
        },
        { "name": "Search Products", "request": { "method": "GET", "url": "{{baseUrl}}/api/products?search=pen&category=Stationery&minPrice=50&maxPrice=500" } },
        { "name": "Get Product by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" } },
        {
          "name": "Update Product Details",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Gel Pen Pack of 15\",\n  \"sku\": \"STNY-PN-713\",\n  \"category\": \"Stationery\",\n  \"price\": 140,\n  \"quantity\": 60,\n  \"reorderLevel\": 20,\n  \"supplier\": \"Cello Pens\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/products/{{productId}}" }
        },
        { "name": "Adjust Stock (+10)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"change\": 10\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/products/{{productId}}/stock" } },
        { "name": "Low Stock Report", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/low-stock" } },
        { "name": "Low Stock Report (threshold 5)", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/low-stock?threshold=5" } },
        { "name": "Category Inventory Summary", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/summary" } },
        { "name": "Delete Product", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/products/{{productId}}" } }
      ]
    }
  ]
}
